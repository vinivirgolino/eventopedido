# Copie este arquivo para .env e preencha com os valores reais.
# Nunca commite o .env.

# ===== Servidor =====
PORT=3000
NODE_ENV=development
# Origens liberadas no CORS, separadas por vírgula (apps Flutter Web)
CORS_ORIGINS=http://localhost:8080

# ===== Banco de dados (Supabase / PostgreSQL via Prisma) =====
# Conexão pelo pooler, usada pela aplicação
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@<host-do-pooler>:6543/postgres?pgbouncer=true
# Conexão direta, usada pelas migrations do Prisma
DIRECT_URL=postgresql://postgres.<project-ref>:<senha>@<host-do-pooler>:5432/postgres

# ===== Supabase Auth =====
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Chave de serviço: uso exclusivo do backend (limpeza de sessões anônimas, app_metadata do admin)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Segredo para validar os JWT emitidos pelo Supabase Auth
SUPABASE_JWT_SECRET=<jwt-secret>

# ===== Operador =====
# Chave do HMAC-SHA-256 usado em operators.access_code_hash
OPERATOR_CODE_HMAC_SECRET=<gere-uma-chave-aleatoria-longa>
# Segredo para assinar o token do operador (expira em events.ends_at)
OPERATOR_TOKEN_SECRET=<gere-outra-chave-aleatoria-longa>

# ===== Mercado Pago =====
# Aplicação da plataforma no painel de desenvolvedores do Mercado Pago (OAuth dos estabelecimentos)
MP_CLIENT_ID=<client-id>
MP_CLIENT_SECRET=<client-secret>
# URL de retorno do OAuth cadastrada na aplicação (GET /oauth/mercadopago/callback)
MP_REDIRECT_URI=http://localhost:3000/api/v1/oauth/mercadopago/callback
# Chave secreta para validar a assinatura das notificações (webhook)
MP_WEBHOOK_SECRET=<segredo-do-webhook>
# Chave pública usada pelo app Flutter para tokenizar o cartão
MP_PUBLIC_KEY=<APP_USR-...>
# Chave para criptografar mp_access_token e mp_refresh_token no banco (32 bytes em base64)
TOKEN_ENCRYPTION_KEY=<gere-uma-chave-aleatoria-de-32-bytes>
